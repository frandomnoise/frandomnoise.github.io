  { "id": "ft8", "name": "FT8 dial frequencies", "channels": [{ "f": "1840 kHz", "label": "160 m" }, { "f": "3573 kHz", "label": "80 m" }, { "f": "5357 kHz", "label": "60 m" }, { "f": "7074 kHz", "label": "40 m" }, { "f": "10136 kHz", "label": "30 m" }, { "f": "14074 kHz", "label": "20 m" }, { "f": "18100 kHz", "label": "17 m" }, { "f": "21074 kHz", "label": "15 m" }, { "f": "24915 kHz", "label": "12 m" }, { "f": "28074 kHz", "label": "10 m" }, { "f": "50313 kHz", "label": "6 m" }], "tags": ["amateur", "data"], "mode": "8-FSK, 6.25 Hz spacing, 15 s periods", "bw": "3 kHz", "demod": "USB", "licence": "amateur", "notes": "Dial frequency in USB. The signals occupy roughly 200-3000 Hz above it. A good live propagation indicator.", "decoder": { "name": "WSJT-X", "url": "https://wsjt.sourceforge.io/" }, "src": ["op:WSJT-X user guide", "iaru1"] },
  { "id": "volmet-shannon", "name": "Shannon VOLMET", "channels": [{ "f": "3413 kHz", "label": "night" }, { "f": "5505 kHz", "label": "" }, { "f": "8957 kHz", "label": "" }, { "f": "13264 kHz", "label": "day" }], "tags": ["aviation", "weather", "voice"], "mode": "USB voice (J3E)", "bw": "3 kHz", "demod": "USB", "licence": "receive-only", "notes": "Continuous weather reports for European airports, read in English.", "src": ["op:Irish Aviation Authority"] },
  { "id": "hfdl", "name": "HFDL (HF data link)", "bands": ["2850-3025 kHz", "3400-3500 kHz", "4650-4700 kHz", "5480-5680 kHz", "6525-6685 kHz", "8815-8965 kHz", "10005-10100 kHz", "11275-11400 kHz", "13260-13360 kHz", "17900-17970 kHz", "21924-22000 kHz"], "tags": ["aviation", "data"], "mode": "PSK, 300-1800 bit/s", "bw": "3 kHz", "demod": "USB", "licence": "receive-only", "notes": "Ground stations use channels inside the aeronautical mobile (R) bands. The current frequency list is sent in the squitters, and dumphfdl can listen to several channels at once.", "decoder": { "name": "dumphfdl", "url": "https://github.com/szpajder/dumphfdl" }, "src": ["rr", "op:ARINC 753"] },
  { "id": "rwm", "name": "RWM time signal", "channels": [{ "f": "4996 kHz", "label": "" }, { "f": "9996 kHz", "label": "" }, { "f": "14996 kHz", "label": "" }], "tags": ["time"], "mode": "Carrier with second pulses (A1N)", "bw": "500 Hz", "demod": "CW", "licence": "receive-only", "notes": "Moscow. Offset 4 kHz from the WWV frequencies, so both can be heard side by side.", "src": ["op:VNIIFTRI"] },
  { "id": "wwv", "name": "WWV time signal", "channels": [{ "f": "5 MHz", "label": "" }, { "f": "10 MHz", "label": "" }, { "f": "15 MHz", "label": "" }], "tags": ["time", "voice"], "mode": "AM, voice announcements and 100 Hz time code", "bw": "6 kHz", "demod": "AM", "licence": "receive-only", "notes": "Fort Collins, Colorado. Often audible in Spain at night on 5 and 10 MHz.", "src": ["op:NIST"] },
  { "id": "nfc", "name": "NFC / RFID 13.56 MHz", "range": "13553-13567 kHz", "tags": ["ism", "data"], "mode": "ASK load modulation, 106-848 kbit/s", "bw": "14 kHz", "licence": "exempt", "notes": "ISM band (RR 5.150). Near-field only, a few cm.", "src": ["rr:5.150", "erc7003"] },
  { "id": "cb27", "name": "CB-27 (citizens band)", "range": "26.965-27.405 MHz", "tags": ["voice"], "mode": "AM, FM, SSB", "bw": "10 kHz", "raster": "10 kHz", "pol": "vertical", "demod": "AM", "licence": "exempt", "notes": "40 channels. Channel 9 (27.065 MHz) emergency, channel 19 (27.185 MHz) road traffic.", "es": "Common use in Spain. Licence and power conditions are set by the CNAF and the ministry CB-27 page. Check the current rules before transmitting.", "src": ["ecc:ECC/DEC/(11)03", "cnaf"] },
