  { "id": "iss", "name": "ISS amateur radio (ARISS)", "channels": [{ "f": "145.800 MHz", "label": "voice / SSTV downlink" }, { "f": "145.825 MHz", "label": "APRS digipeater" }, { "f": "437.800 MHz", "label": "cross-band repeater downlink" }], "tags": ["amateur", "satellite", "voice"], "mode": "NFM, SSTV (PD120), AFSK 1200 Bd APRS", "bw": "12.5 kHz", "pol": "circular or vertical", "demod": "NFM", "licence": "amateur", "notes": "Repeater uplink 145.990 MHz with 67 Hz CTCSS. Doppler is up to ±3.5 kHz on 145.8 MHz and ±10 kHz on 437.8 MHz.", "sat": { "norad": 25544, "group": "stations" }, "src": ["ariss"] },
