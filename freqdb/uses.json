  { "id": "ndb", "name": "NDB (non-directional beacons)", "range": "190-1750 kHz", "tags": ["aviation", "navigation", "beacon"], "mode": "Carrier with Morse ident, usually 1020 Hz tone (A2A) or keyed carrier", "bw": "1 kHz", "pol": "vertical", "demod": "AM", "licence": "receive-only", "notes": "Most European NDBs sit between 255 and 526.5 kHz. Listen in CW or AM for the ident.", "src": ["icao"] },
  { "id": "navtex", "name": "NAVTEX", "channels": [{ "f": "490 kHz", "label": "national language" }, { "f": "518 kHz", "label": "international, English" }, { "f": "4209.5 kHz", "label": "HF NAVTEX" }], "tags": ["maritime", "data", "distress"], "mode": "SITOR-B (FSK, 100 Bd, 170 Hz shift)", "bw": "500 Hz", "demod": "USB", "licence": "receive-only", "notes": "Maritime safety information. In USB, tune 1.7 kHz lower to get the tones around 1700 Hz.", "es": "Spanish stations broadcast on 518 kHz in English and 490 kHz in Spanish.", "decoder": { "name": "fldigi", "url": "http://www.w1hkj.com/" }, "src": ["rr:5.79A"] },
