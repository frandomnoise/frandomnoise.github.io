  { "id": "adsb", "name": "Mode S / ADS-B (1090ES)", "f": "1090 MHz", "tags": ["aviation", "data"], "mode": "PPM, 1 Mbit/s", "bw": "2 MHz", "pol": "vertical", "demod": "RAW", "licence": "receive-only", "notes": "Replies and extended squitter from aircraft. A quarter-wave ground plane of 69 mm is enough to start.", "decoder": { "name": "dump1090", "url": "https://github.com/flightaware/dump1090" }, "src": ["icao"] },
  { "id": "gnss", "name": "GNSS signals", "channels": [{ "f": "1176.45 MHz", "label": "GPS L5 / Galileo E5a" }, { "f": "1207.14 MHz", "label": "Galileo E5b" }, { "f": "1227.60 MHz", "label": "GPS L2" }, { "f": "1278.75 MHz", "label": "Galileo E6" }, { "f": "1575.42 MHz", "label": "GPS L1 / Galileo E1" }], "tags": ["gnss", "satellite"], "mode": "BPSK / BOC spread spectrum", "bw": "2 MHz", "pol": "RHCP", "demod": "RAW", "licence": "receive-only", "notes": "Signals sit below the noise floor, a correlator is needed. GLONASS L1 is FDMA around 1602 MHz.", "decoder": { "name": "GNSS-SDR", "url": "https://gnss-sdr.org/" }, "src": ["op:GPS ICD / Galileo OS SIS ICD"] },
